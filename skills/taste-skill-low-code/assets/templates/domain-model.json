{
  "module": "Orders",
  "entities": [
    {
      "name": "Customer",
      "doc": "Uma empresa ou pessoa que faz pedidos.",
      "persistable": true,
      "attributes": [
        { "name": "Name", "type": "String" },
        { "name": "TaxNumber", "type": "String" },
        { "name": "IsActive", "type": "Boolean", "default": true }
      ],
      "access": ["Sales", "Manager"]
    },
    {
      "name": "Order",
      "doc": "Um pedido de compra feito por um cliente.",
      "persistable": true,
      "attributes": [
        { "name": "Number", "type": "AutoNumber" },
        { "name": "Status", "type": "Enumeration", "enumeration": "ENUM_OrderStatus" },
        { "name": "Total", "type": "Decimal" },
        { "name": "DueDate", "type": "DateTime" },
        { "name": "SubmittedOn", "type": "DateTime" },
        { "name": "IsUrgent", "type": "Boolean", "default": false }
      ],
      "access": ["Sales", "Manager"]
    },
    {
      "name": "OrderLine",
      "doc": "Um item de um pedido: um produto e a quantidade pedida.",
      "persistable": true,
      "attributes": [
        { "name": "Quantity", "type": "Integer" },
        { "name": "UnitPrice", "type": "Decimal" }
      ],
      "access": ["Sales", "Manager"]
    },
    {
      "name": "Product",
      "doc": "Um produto do catálogo que pode ser pedido.",
      "persistable": true,
      "attributes": [
        { "name": "Code", "type": "String" },
        { "name": "Name", "type": "String" },
        { "name": "ListPrice", "type": "Decimal" }
      ],
      "access": ["Sales", "Manager"]
    },
    {
      "name": "OrderFilter",
      "doc": "Os critérios de busca escolhidos na página de pedidos.",
      "persistable": false,
      "attributes": [
        { "name": "SearchText", "type": "String" },
        { "name": "Status", "type": "Enumeration", "enumeration": "ENUM_OrderStatus" },
        { "name": "FromDate", "type": "DateTime" }
      ]
    }
  ],
  "associations": [
    { "name": "Order_Customer", "from": "Order", "to": "Customer", "multiplicity": "*-1", "onDeleteOfTarget": "prevent" },
    { "name": "OrderLine_Order", "from": "OrderLine", "to": "Order", "multiplicity": "*-1", "onDeleteOfTarget": "delete" },
    { "name": "OrderLine_Product", "from": "OrderLine", "to": "Product", "multiplicity": "*-1", "onDeleteOfTarget": "prevent" }
  ],
  "enumerations": [
    { "name": "ENUM_OrderStatus", "values": ["Draft", "Submitted", "Approved", "Cancelled"] }
  ]
}
